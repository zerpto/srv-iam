# Copy to `.env` for local work. `.env` is read at startup; variables already set
# in the shell win over it. Every value below has a development default in
# config/development.yaml, so this file only needs what you want to change.

# This service's own Postgres database.
DATABASE_URL=postgres://loco:loco@localhost:5432/service_template_development

# Token check; identical in every service.
JWT_SECRET=dev-only-shared-secret-change-me

# Queue jobs and (production) the idempotency cache.
REDIS_URL=redis://127.0.0.1:6379

# gRPC server of this service: the address it listens on, for other services to call.
GRPC_BINDING=0.0.0.0
GRPC_PORT=5001

# gRPC peers this service calls (an address to connect to; nothing listens on it here).
# Reference-data service: checks a tenant's address. Its own GRPC_PORT must match.
REFERENCE_DATA_GRPC_URL=http://localhost:5002

# This service's name; names its event stream and subjects.
SERVICE_NAME=service-template

# Event streaming (off by default in development).
EVENTS_ENABLED=false
NATS_URL=nats://localhost:4222

# CORS origin of the web app.
WEB_APP_URL=http://localhost:3000

# Error reporting; leave empty to turn it off.
SENTRY_DSN=

# Extension registry: the platform operator's key (sent as X-Platform-Key) and
# internal hosts a manifest may be fetched from over plain HTTP.
PLATFORM_API_KEY=dev-only-platform-key
EXTENSION_ALLOWED_HOSTS=localhost,127.0.0.1

# Where the core extensions serve their federation/manifest.yaml (their
# federation/ apps; relay's own service), fetched at startup and stored as
# manifest_url. Required in production. A plain-HTTP host must be in
# EXTENSION_ALLOWED_HOSTS.
IAM_MANIFEST_URL=http://localhost:3001/manifest.yaml
REFERENCE_DATA_MANIFEST_URL=http://localhost:3002/manifest.yaml
RELAY_MANIFEST_URL=http://localhost:3003/manifest.yaml
# Optional, also in production: empty leaves billing out.
BILLING_MANIFEST_URL=

# Relay service queue (off by default).
RELAY_ENABLED=false
RELAY_REDIS_URL=redis://127.0.0.1:6379

# Files: local disk by default; set STORAGE_DRIVER=r2 and the R2_* values to use R2.
STORAGE_DRIVER=local
# R2_BUCKET=
# R2_ENDPOINT=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
