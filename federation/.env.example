# Copy to `.env` for local overrides. Read when the server starts; every value below is the
# default. Nothing here is secret, and nothing here reaches the browser.
#
# The port is `port` in extension.json. Override it with the PORT environment variable
# (`PORT=3201 pnpm dev`); it cannot be set in this file.

# Public address of this app, written into manifest.yaml as the remote's URL. IAM's
# IAM_MANIFEST_URL is this address plus /manifest.yaml.
# Empty: http://localhost:<port>.
EXTENSION_URL=

# Origin of the web app, allowed (CORS) to load the remote.
WEB_APP_URL=http://localhost:3000
