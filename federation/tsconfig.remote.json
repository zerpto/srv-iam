{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "strict": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "isolatedModules": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": [
        "./remote/*"
      ],
      "next-intl": [
        "./node_modules/use-intl"
      ],
      "next/link": [
        "./remote/shims/next-link.tsx"
      ],
      "next/navigation": [
        "./remote/shims/next-navigation.ts"
      ],
      "react": [
        "./node_modules/@types/react"
      ],
      "react/*": [
        "./node_modules/@types/react/*"
      ]
    }
  },
  "include": [
    "remote"
  ]
}
