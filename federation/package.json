{
  "name": "extension-iam",
  "version": "0.1.0",
  "private": true,
  "description": "IAM settings screens: a Next.js app serving a federated frontend that web.app loads",
  "type": "module",
  "scripts": {
    "dev": "node scripts/run.mjs dev",
    "build": "rsbuild build && next build",
    "start": "node scripts/run.mjs start",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.remote.json && tsc -p tsconfig.node.json",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@11.0.3",
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^5.9.2",
    "@internationalized/date": "^3.12.4",
    "@tanstack/react-query": "^5.104.5",
    "@zerpto/sdk": "git+https://github.com/zerpto/web-sdk.git#semver:~0.1.0",
    "@zerpto/ui": "git+https://github.com/zerpto/web-ui.git#semver:~0.1.0",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.90.0",
    "sonner": "^2.0.8",
    "use-intl": "^4.14.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@module-federation/rsbuild-plugin": "^2.9.4",
    "@rsbuild/core": "^2.3.4",
    "@rsbuild/plugin-react": "^2.1.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3"
  }
}
